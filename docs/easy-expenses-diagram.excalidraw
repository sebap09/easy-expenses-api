    },
    {
      "id": "d5vqJEdz5_am_iMczXTAs",
      "type": "text",
      "x": 6968.120789537523,
      "y": 201.12512191412134,
      "width": 431.19940185546875,
      "height": 440,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b77",
      "roundness": null,
      "seed": 1007305422,
      "version": 250,
      "versionNonce": 1528405902,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781869064868,
      "link": null,
      "locked": false,
      "text": "CREATE TABLE expense ( \n    id BIGINT PRIMARY KEY, \n    user_id BIGINT NOT NULL, \n    category_id BIGINT NOT NULL,\n    sub_category_id BIGINT NOT NULL,\n    payment_type_id BIGINT NOT NULL,\n    \n    date DATE,\n    value DECIMAL(15,2),\n    comment VARCHAR(50),\n\n    FOREIGN KEY (category_id, user_id) \n        REFERENCES category(id, user_id),\n    FOREIGN KEY (sub_category_id, user_id) \n        REFERENCES sub_category(id, user_id),\n    FOREIGN KEY (payment_type_id, user_id) \n        REFERENCES payment_type(id, user_id),\n\n    FOREIGN KEY (sub_category_id, category_id) \n        REFERENCES sub_category(id, category_id),\n    \n);",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CREATE TABLE expense ( \n    id BIGINT PRIMARY KEY, \n    user_id BIGINT NOT NULL, \n    category_id BIGINT NOT NULL,\n    sub_category_id BIGINT NOT NULL,\n    payment_type_id BIGINT NOT NULL,\n    \n    date DATE,\n    value DECIMAL(15,2),\n    comment VARCHAR(50),\n\n    FOREIGN KEY (category_id, user_id) \n        REFERENCES category(id, user_id),\n    FOREIGN KEY (sub_category_id, user_id) \n        REFERENCES sub_category(id, user_id),\n    FOREIGN KEY (payment_type_id, user_id) \n        REFERENCES payment_type(id, user_id),\n\n    FOREIGN KEY (sub_category_id, category_id) \n        REFERENCES sub_category(id, category_id),\n    \n);",
      "autoResize": true,
      "lineHeight": 1.25
    },
